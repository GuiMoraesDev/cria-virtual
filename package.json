{
  "name": "cria-virtual",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "check": "npm run version:check && npm run validate && npm run check-types && npm run test",
    "version:check": "node .husky/scripts/check-version.js",
    "validate": "CLAUDE_CONFIG_DIR=$HOME/.claude-personal claude plugin validate .",
    "check-types": "tsc -p .",
    "test": "CLAUDE_CONFIG_DIR=$HOME/.claude-personal claude plugin test ."
  },
  "devDependencies": {
    "typescript": "5.6.3",
    "husky": "^9.1.7"
  },
  "type": "module"
}
